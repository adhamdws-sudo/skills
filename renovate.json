using UnityEngine;

public class DroneController : MonoBehaviour
{
    [Header("Movement Settings")]
    public float moveSpeed = 8f;
    public float rotationSpeed = 60f;
    public float verticalSpeed = 5f;

    private float horizontalInput;
    private float verticalInput;
    private float altitudeInput;
    private float turnInput;

    void Update()
    {
        // Keyboard controls for testing
        horizontalInput = Input.GetAxis("Horizontal");
        verticalInput = Input.GetAxis("Vertical");

        altitudeInput = 0f;
        turnInput = 0f;

        if (Input.GetKey(KeyCode.Space))
            altitudeInput = 1f;

        if (Input.GetKey(KeyCode.LeftControl))
            altitudeInput = -1f;

        if (Input.GetKey(KeyCode.Q))
            turnInput = -1f;

        if (Input.GetKey(KeyCode.E))
            turnInput = 1f;

        // Move forward and sideways
        Vector3 movement =
            transform.forward * verticalInput * moveSpeed +
            transform.right * horizontalInput * moveSpeed;

        transform.position += movement * Time.deltaTime;

        // Move up and down
        transform.position +=
            Vector3.up * altitudeInput * verticalSpeed * Time.deltaTime;

        // Rotate drone
        transform.Rotate(
            Vector3.up,
            turnInput * rotationSpeed * Time.deltaTime
        );
    }

    // These methods can be connected to mobile UI buttons.
    public void MoveForward()
    {
        transform.position +=
            transform.forward * moveSpeed * Time.deltaTime;
    }

    public void MoveBackward()
    {
        transform.position -=
            transform.forward * moveSpeed * Time.deltaTime;
    }

    public void MoveLeft()
    {
        transform.position -=
            transform.right * moveSpeed * Time.deltaTime;
    }

    public void MoveRight()
    {
        transform.position +=
            transform.right * moveSpeed * Time.deltaTime;
    }

    public void Rise()
    {
        transform.position +=
            Vector3.up * verticalSpeed * Time.deltaTime;
    }

    public void Descend()
    {
        transform.position -=
            Vector3.up * verticalSpeed * Time.deltaTime;
    }
}using UnityEngine;

public class DroneEnvironment : MonoBehaviour
{
    public int mountainCount = 20;
    public float environmentSize = 150f;

    void Start()
    {
        CreateGround();
        CreateMountains();
        CreateLighting();
    }

    void CreateGround()
    {
        GameObject ground = GameObject.CreatePrimitive(
            PrimitiveType.Plane
        );

        ground.name = "TerrainGround";
        ground.transform.position = Vector3.zero;
        ground.transform.localScale = new Vector3(15f, 1f, 15f);

        Renderer renderer = ground.GetComponent<Renderer>();
        renderer.material.color = new Color(0.28f, 0.42f, 0.22f);
    }

    void CreateMountains()
    {
        for (int i = 0; i < mountainCount; i++)
        {
            GameObject mountain = GameObject.CreatePrimitive(
                PrimitiveType.Cube
            );

            mountain.name = "Mountain_" + i;

            float x = Random.Range(
                -environmentSize / 2f,
                environmentSize / 2f
            );

            float z = Random.Range(
                -environmentSize / 2f,
                environmentSize / 2f
            );

            float height = Random.Range(10f, 35f);
            float width = Random.Range(8f, 20f);

            mountain.transform.position =
                new Vector3(x, height / 2f, z);

            mountain.transform.localScale =
                new Vector3(width, height, width);

            mountain.transform.rotation = Quaternion.Euler(
                Random.Range(-8f, 8f),
                Random.Range(0f, 360f),
                Random.Range(-8f, 8f)
            );

            mountain.GetComponent<Renderer>().material.color =
                new Color(0.38f, 0.40f, 0.36f);
        }
    }

    void CreateLighting()
    {
        GameObject lightObject = new GameObject("SunLight");

        Light sun = lightObject.AddComponent<Light>();
        sun.type = LightType.Directional;
        sun.intensity = 1.2f;

        lightObject.transform.rotation =
            Quaternion.Euler(45f, -30f, 0f);
    }
}using UnityEngine;

public class DroneCamera : MonoBehaviour
{
    public Transform target;

    public Vector3 cameraOffset =
        new Vector3(0f, 3f, -7f);

    public float followSpeed = 5f;

    void LateUpdate()
    {
        if (target == null)
            return;

        Vector3 desiredPosition =
            target.position +
            target.rotation * cameraOffset;

        transform.position = Vector3.Lerp(
            transform.position,
            desiredPosition,
            followSpeed * Time.deltaTime
        );

        transform.LookAt(target.position);
    }
}
